# ============================================================================
#  MilkTea Iku — Environment Variables Template
# ============================================================================
#  Copy this file to `.env.local` for local development.
#  In production (Vercel/Render/Fly), set these as platform secrets — NEVER
#  commit real values to git. See SECURITY_NOTICE.md.
# ----------------------------------------------------------------------------

# ----- Database ------------------------------------------------------------
# Local dev (SQLite, single file):
DATABASE_URL="file:./backend/prisma/dev.db"
#
# Production (PostgreSQL — recommended for serverless):
# DATABASE_URL="postgresql://user:pass@host:5432/milktea?sslmode=require"
#
# Production (MySQL, alternative):
# DATABASE_URL="mysql://user:pass@host:3306/milktea?ssl-mode=REQUIRED"

# ----- Admin authentication ------------------------------------------------
# Username for HTTP Basic Auth on /admin and /api/admin/*
ADMIN_USERNAME=admin

# Plaintext password — DEV ONLY. Generate strong value with:
#   openssl rand -base64 24
ADMIN_PASSWORD=your-strong-password-here

# (Recommended for production) scrypt-hashed password. Generate with:
#   node scripts/generate-admin-hash.mjs
# When ADMIN_PASSWORD_HASH is set, ADMIN_PASSWORD is ignored.
# ADMIN_PASSWORD_HASH="scrypt$16384$8$1$<salt-hex>$<derived-hex>"

# Bearer token for programmatic admin access. Generate with:
#   openssl rand -base64 48
ADMIN_API_TOKEN=your-api-token-here

# ----- n8n chatbot integration (optional) ---------------------------------
# Absolute HTTPS URL of your n8n webhook
N8N_WEBHOOK_URL=

# Comma-separated allowlist of permitted hostnames for SSRF protection.
# Leave empty to disable allowlisting (still blocks private IPs).
# Example: N8N_HOSTNAMES="n8n.example.com,workflow.example.com"
N8N_HOSTNAMES=

# n8n basic auth (only for docker-compose self-host of n8n itself)
N8N_USER=admin
N8N_PASSWORD=your-n8n-password-here

# ----- E2E / Playwright (CI only) ------------------------------------------
# Base URL the test runner targets. Leave empty to use http://localhost:3000.
E2E_BASE_URL=
