{
  "name": "milktea-iku",
  "version": "1.0.0",
  "private": true,
  "description": "Premium Milk Tea E-Commerce Platform — Personal learning portfolio by Nguyễn Sơn. Production-shaped Next.js 14 + TypeScript + Prisma reference implementation.",
  "author": {
    "name": "Nguyễn Sơn",
    "email": "jasonbmt06@gmail.com",
    "url": "https://github.com/JasonTM17"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonTM17/MilkTea_Iku.git"
  },
  "homepage": "https://milktea-iku.vercel.app",
  "bugs": {
    "url": "https://github.com/JasonTM17/MilkTea_Iku/issues"
  },
  "keywords": [
    "milktea",
    "milk-tea",
    "boba",
    "ecommerce",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "prisma"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "analyze": "cross-env ANALYZE=true next build",
    "db:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "db:seed": "npx tsx backend/prisma/seed.ts",
    "db:studio": "prisma studio --schema=backend/prisma/schema.prisma",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/client": "^5.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.577.0",
    "next": "^14.2.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "husky": "^9.1.6",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.0",
    "prettier": "^3.3.3",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
