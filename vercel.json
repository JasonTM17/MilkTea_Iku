{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "DATABASE_URL=file:./prisma/dev.db npx prisma generate && DATABASE_URL=file:./prisma/dev.db npx prisma db push && DATABASE_URL=file:./prisma/dev.db npx tsx prisma/seed.ts && npm run build && cp prisma/dev.db .next/server/prisma-dev.db",
  "installCommand": "npm ci --legacy-peer-deps",
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ],
  "rewrites": [],
  "env": {
    "DATABASE_URL": "file:./prisma/dev.db",
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "milktea-iku-2026",
    "ADMIN_API_TOKEN": "milktea-iku-admin-token-2026"
  }
}
